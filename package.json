{
  "name": "muinaismuistot",
  "version": "1.46.0",
  "description": "Tutki kartalla Museoviraston ylläpitämien kulttuuriperintörekistereiden paikkatietoa.",
  "scripts": {
    "lint": "npx eslint .",
    "build:prod": "NODE_ENV=production webpack --mode=production --progress",
    "build:dev": "webpack --mode=development --progress --devtool source-map",
    "worker:dev": "npm --prefix infra/muinaismuistot-worker run dev",
    "worker:test": "npm --prefix infra/muinaismuistot-worker test",
    "worker:typecheck": "npm --prefix infra/muinaismuistot-worker run typecheck",
    "worker:deploy:dry-run": "npm --prefix infra/muinaismuistot-worker run deploy:dry-run",
    "worker:deploy": "npm --prefix infra/muinaismuistot-worker run deploy",
    "worker:deploy:preview:dry-run": "npm --prefix infra/muinaismuistot-worker run deploy:preview:dry-run",
    "worker:deploy:preview": "npm --prefix infra/muinaismuistot-worker run deploy:preview",
    "test:e2e": "playwright test --project=pmtiles",
    "test:e2e:wms": "playwright test --project=wms",
    "test:e2e:all": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.playwright.json",
    "dev": "webpack serve --mode=development --server-type https --host 0.0.0.0 --port 8091 --allowed-hosts all --progress --hot --open",
    "dev:preview-api": "npm run dev -- --open-target '/?museovirastoVectorTiles=1&museovirastoApiBase=https%3A%2F%2Fmuinaismuistot-preview.antti-kekki.workers.dev'",
    "dev:prod-api": "npm run dev -- --open-target '/?museovirastoVectorTiles=1&museovirastoApiBase=https%3A%2F%2Fmuinaismuistot.info'",
    "prod": "NODE_ENV=production webpack serve --mode=production --server-type https --host 0.0.0.0 --port 8091 --allowed-hosts all --progress --hot --open",
    "profile-size": "NODE_ENV=production SHOW_BUNDLE_ANALYZER=true webpack --progress",
    "addDataToMaisemanMuisti": "node scripts/addDataToMaisemanMuisti.js",
    "check-updates": "npx npm-check-updates"
  },
  "author": "Antti Kekki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/anttikekki/muinaismuistot.git"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "@turf/centroid": "7.4.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "debounce": "3.0.0",
    "i18next": "26.4.0",
    "lru-cache": "11.5.2",
    "ol": "10.10.0",
    "ol-pmtiles": "2.0.2",
    "proj4": "2.21.0",
    "query-string": "9.5.0",
    "react": "19.2.8",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "eslint": "10.9.0",
    "html-webpack-plugin": "5.6.8",
    "npm-check-updates": "23.0.2",
    "prettier": "3.9.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "url-loader": "4.1.1",
    "webpack": "5.109.2",
    "webpack-bundle-analyzer": "5.3.1",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
