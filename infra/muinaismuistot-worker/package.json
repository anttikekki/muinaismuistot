{
  "name": "muinaismuistot-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm --prefix ../.. run build:prod && vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "deploy:dry-run": "wrangler deploy --env production --dry-run",
    "deploy": "npm test && npm run typecheck && wrangler deploy --env production",
    "deploy:preview:dry-run": "npm --prefix ../.. run build:preview && wrangler deploy --env preview --dry-run",
    "deploy:preview": "npm test && npm run typecheck && npm --prefix ../.. run build:preview && wrangler deploy --env preview",
    "check-updates": "npx npm-check-updates"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/range-parser": "1.2.7",
    "npm-check-updates": "23.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "range-parser": "^1.3.0"
  }
}
