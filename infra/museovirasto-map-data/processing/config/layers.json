{
  "schemaVersion": 2,
  "description": "Build-only projections and tiling settings. Source files and layers are defined in contract/layer-mapping.json.",
  "tiling": {
    "minimumZoom": 0,
    "maximumZoom": 14,
    "lowZoomCentroidMaximumZoom": 9,
    "polygonMinimumZoom": 10,
    "dropRate": 1,
    "featureLimit": false,
    "tileSizeLimit": false,
    "tinyPolygonReduction": false
  },
  "budgets": { "maximumArchiveBytes": 75000000, "maximumZoomZeroTileBytes": 1500000 },
