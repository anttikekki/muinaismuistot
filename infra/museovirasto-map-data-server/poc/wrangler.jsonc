{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "museovirasto-pmtiles-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "r2_buckets": [
    {
      "binding": "MAP_DATA",
      "bucket_name": "museovirasto-map-data-poc"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/pmtiles/*", "/api/*"]
  }
}
