{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "museovirasto-pmtiles-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "r2_buckets": [
    {
      "binding": "MAP_DATA",
      "bucket_name": "museovirasto-map-data-poc"
    }
  ],
  "d1_databases": [
    {
      "binding": "MAP_FEATURES",
      "database_name": "museovirasto-map-features-poc",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/pmtiles/*", "/api/*", "/health"]
  }
}
